# TypeORM / MySQL connection — read by src/database/database.module.ts
# Matches the credentials defined in /docker-compose.yml at the monorepo root.
# Host port 3307 (not 3306) because something else on the host is already
# listening on 127.0.0.1:3306.
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=vivaidea
DB_PASSWORD=vivaidea
DB_NAME=vivaidea

# Set to "false" in production — use proper migrations instead of synchronize.
DB_SYNCHRONIZE=true

# JWT signing secrets — read by src/auth/strategies/jwt-{access,refresh}.strategy.ts.
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating either value invalidates every outstanding token immediately.
JWT_ACCESS_SECRET=replace-me-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-strong-random-secret

# JWT expiry durations (parsed by ms / jsonwebtoken)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_PUBLIC_PREFIX=/api/v1/uploads/files
